#include <iostream>
using namespace std;
#include <cstring>

int search( const int nums[], int n, int target){
    int l=0, h=n-1;
    while ( l<=h){
        int mid= l+ (h-l)/2;
        if (nums[mid]==target){
            return mid;
        } else if (nums[mid]< target){
            l=mid+1;
        } else{
            h=mid-1;
        }
    }
    return -1;
}

int main() {
    int nums[10000], n, target;
    cin>>n>>target;
    
    for ( int i=0; i<n; i++)
        cin>>nums[i];
        
    cout<<search( nums, n, target);
    return 0;
}
